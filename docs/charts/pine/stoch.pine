//@version=5
// Charts indicator "stoch": Pine is the definition, Charts' C++ engine (src/charts/core) executes it.
// Checked on every build by tests/charts/core/pine_reference_tests.cpp. Inputs titled with Charts' keys, plots with its outputs.
indicator("Stochastic", precision=16)
kLength = input.int(14, "k", minval=1)
smoothK = input.int(1, "smoothK", minval=1)
dLength = input.int(3, "d", minval=1)
k = ta.sma(ta.stoch(close, high, low, kLength), smoothK)
plot(k, "k")
plot(ta.sma(k, dLength), "d")
