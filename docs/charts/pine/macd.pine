//@version=5
// Charts indicator "macd": Pine is the definition, Charts' C++ engine (src/charts/core) executes it.
// Checked on every build by tests/charts/core/pine_reference_tests.cpp. Inputs titled with Charts' keys, plots with its outputs.
indicator("MACD", precision=16)
fast = input.int(12, "fast", minval=1)
slow = input.int(26, "slow", minval=1)
signal = input.int(9, "signal", minval=1)
source = input.source(close, "source")
m = ta.ema(source, fast) - ta.ema(source, slow)
s = ta.ema(m, signal)
plot(m - s, "hist", style=plot.style_histogram)
plot(m, "macd")
plot(s, "signal")
