//@version=5
// Charts indicator "vwap": Pine is the definition, Charts' C++ engine (src/charts/core) executes it.
// Checked on every build by tests/charts/core/pine_reference_tests.cpp. Inputs titled with Charts' keys, plots with its outputs.
indicator("Volume Weighted Average Price (VWAP)", overlay=true, precision=16)
source = input.source(hlc3, "source")
anchor = input.string("day", "anchor", options=["day", "week", "month", "year"])
newPeriod = anchor == "day" ? timeframe.change("D") : anchor == "week" ? timeframe.change("W") : anchor == "month" ? timeframe.change("M") : timeframe.change("12M")
// as TradingView's own VWAP script: the first bar of the data starts a period
if na(source[1])
    newPeriod := true
plot(ta.vwap(source, newPeriod), "value")
