//@version=5
// Charts indicator "bbw": Pine is the definition, Charts' C++ engine (src/charts/core) executes it.
// Checked on every build by tests/charts/core/pine_reference_tests.cpp. Inputs titled with Charts' keys, plots with its outputs.
indicator("Bollinger BandWidth", precision=16)
length = input.int(20, "length", minval=1)
source = input.source(close, "source")
mult = input.float(2.0, "mult")
basis = ta.sma(source, length)
dev = mult * ta.stdev(source, length)
plot(((basis + dev) - (basis - dev)) / basis * 100, "value")
