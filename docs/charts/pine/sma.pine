//@version=5
// Charts indicator "sma": Pine is the definition, Charts' C++ engine (src/charts/core) executes it.
// Checked on every build by tests/charts/core/pine_reference_tests.cpp. Inputs titled with Charts' keys, plots with its outputs.
indicator("Moving Average (SMA)", overlay=true, precision=16)
length = input.int(20, "length", minval=1)
source = input.source(close, "source")
plot(ta.sma(source, length), "value")
