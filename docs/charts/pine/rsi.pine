//@version=5
// Charts indicator "rsi": Pine is the definition, Charts' C++ engine (src/charts/core) executes it.
// Checked on every build by tests/charts/core/pine_reference_tests.cpp. Inputs titled with Charts' keys, plots with its outputs.
indicator("Relative Strength Index (RSI)", precision=16)
length = input.int(14, "length", minval=1)
source = input.source(close, "source")
maLength = input.int(14, "maLength", minval=0)
value = ta.rsi(source, length)
plot(value, "value")
plot(maLength > 0 ? ta.sma(value, maLength) : na, "ma")
