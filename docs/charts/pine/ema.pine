//@version=5
// Charts indicator "ema": Pine is the definition, Charts' C++ engine (src/charts/core) executes it.
// Checked on every build by tests/charts/core/pine_reference_tests.cpp. Inputs titled with Charts' keys, plots with its outputs.
indicator("Exponential Moving Average (EMA)", overlay=true, precision=16)
length = input.int(9, "length", minval=1)
source = input.source(close, "source")
plot(ta.ema(source, length), "value")
