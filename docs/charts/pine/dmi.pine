//@version=5
// Charts indicator "dmi": Pine is the definition, Charts' C++ engine (src/charts/core) executes it.
// Checked on every build by tests/charts/core/pine_reference_tests.cpp. Inputs titled with Charts' keys, plots with its outputs.
indicator("Directional Movement (DMI / ADX)", precision=16)
diLength = input.int(14, "diLength", minval=1)
adxSmoothing = input.int(14, "adxSmoothing", minval=1)
[plus, minus, adx] = ta.dmi(diLength, adxSmoothing)
plot(adx, "adx")
plot(plus, "plus")
plot(minus, "minus")
